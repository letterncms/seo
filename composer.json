{
    "name": "letterncms/seo",
    "description": "Search and generative engine optimization: meta tags, social cards, JSON-LD, sitemap, robots and AI crawlers, llms.txt, Markdown twins, redirects and on-page checks.",
    "type": "cms-plugin",
    "version": "0.11.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.26 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Seo\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "SEO",
            "icon": "seo",
            "provider": "Cms\\Seo\\SeoPlugin",
            "modules": [
                "letterncms/site"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/seo"
}
